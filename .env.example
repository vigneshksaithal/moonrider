# Copy to .env, adjust, and source it in EACH Go terminal.
# .env is not automatically loaded. Do not commit private keys or your .env.
export DATABASE_URL='postgres://moonrider:local-demo-only@127.0.0.1:5432/moonrider?sslmode=disable'
export HTTP_ADDR='127.0.0.1:8080'
export ALLOWED_ORIGINS='http://localhost:5173,http://127.0.0.1:5173'
export MQTT_BROKER='tcp://127.0.0.1:1883'
# AWS: change MQTT_BROKER to ssl://YOUR-ATS-ENDPOINT:8883
# Use a DIFFERENT certificate/key and client ID in each terminal.
# export MQTT_CERT='/absolute/path/to/moonrider/certs/backend.pem'
# export MQTT_KEY='/absolute/path/to/moonrider/certs/backend.key'
# export MQTT_CA='/absolute/path/to/moonrider/certs/AmazonRootCA1.pem'
# export MQTT_CLIENT_ID='moonrider-backend'
# Fault thresholds are defined in backend/internal/domain/model.go: DefaultRules().
